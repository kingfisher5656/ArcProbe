          "stringUnit": {
            "state": "translated",
            "value": "%@에 가져오기"
          }
        }
      }
    },
    "Import preview ready: %lld scores can be added; %lld scored rows skipped. No archive or sheet scores changed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Import preview ready: %1$lld scores can be added; %2$lld scored rows skipped. No archive or sheet scores changed."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 미리보기 준비 완료: 점수 %1$lld개를 추가할 수 있고, 점수가 있는 행 %2$lld개는 건너뜁니다. 저장된 기록과 시트 점수는 바뀌지 않았습니다."
          }
        }
      }
    },
    "Import reviewed scores": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인한 점수 가져오기"
          }
        }
      }
    },
    "Import scores and potential history": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "점수 및 포텐셜 기록 가져오기"
          }
        }
      }
    },
    "Import scores from sheet": {
