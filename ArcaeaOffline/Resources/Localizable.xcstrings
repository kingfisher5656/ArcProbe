    "Google Sheets": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 스프레드시트"
          }
        }
      }
    },
    "Google Sheets request failed (HTTP %lld). Retry later; pending recovery is preserved.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 스프레드시트 요청에 실패했습니다 (HTTP %lld). 나중에 다시 시도해 주세요. 대기 중인 복구 기록은 유지됩니다."
          }
        }
      }
    },
    "Google authorization expired. Connect again, then retry recovery if needed.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 인증이 만료되었습니다. 다시 연결한 뒤, 필요하면 복구를 다시 시도해 주세요."
          }
        }
      }
    },
    "Google connection restored.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 연결을 복원했습니다."
          }
        }
      }
    },
    "Google could not access the selected file. Select it again through Google Picker.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google이 선택한 파일에 접근하지 못했습니다. Google 파일 선택 화면에서 다시 선택해 주세요."
          }
        }
      }
    },
    "Google denied access. Check the selected account, file permissions and that Sheets / Drive / Picker APIs are enabled.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google이 접근을 거부했습니다. 선택한 계정과 파일 권한, 그리고 Sheets / Drive / Picker API가 사용 설정되어 있는지 확인해 주세요."
          }
        }
      }
    },
    "Google rate limited this request. Wait %@ seconds before retrying.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google이 요청 횟수를 제한했습니다. %@초 기다린 뒤 다시 시도해 주세요."
          }
        }
      }
    },
    "Google session could not be saved in Keychain. Unlock the device and retry.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 세션을 키체인에 저장하지 못했습니다. 기기 잠금을 해제한 뒤 다시 시도해 주세요."
          }
        }
      }
    },
    "Google session removed from this device. Google account access can also be revoked in Google settings.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Google 세션을 지웠습니다. Google 계정 접근 권한은 Google 설정에서도 해제할 수 있습니다."
          }
        }
      }
    },
    "Google sign-in / Picker": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 로그인 / 파일 선택"
          }
        }
      }
    },
    "Google sign-in was cancelled or failed. Check consent test-user access, client configuration and the callback after SideStore installation, then reconnect.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 로그인이 취소되었거나 실패했습니다. 테스트 사용자 등록, 클라이언트 설정, SideStore 설치 후의 콜백을 확인한 뒤 다시 연결해 주세요."
          }
        }
      }
    },
    "Google token refresh temporarily failed. Retry when connected.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 토큰 갱신에 일시적으로 실패했습니다. 인터넷에 연결된 뒤 다시 시도해 주세요."
          }
        }
      }
    },
