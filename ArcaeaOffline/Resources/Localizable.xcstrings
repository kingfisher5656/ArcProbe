    "Additional judgments": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가 판정"
          }
        }
      }
    },
    "After Arcaea closes, the loop makes two more checks and then ends.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Arcaea를 닫으면 두 번 더 확인한 뒤 반복이 끝납니다."
          }
        }
      }
    },
    "All": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체"
          }
        }
      }
    },
    "All %lld covers are already copied": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재킷 %lld개가 모두 복사되어 있습니다"
          }
        }
      }
    },
    "All levels": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 레벨"
          }
        }
      }
    },
    "All packs": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 팩"
          }
        }
      }
    },
    "All recognized mobile scores already match.": {
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인식된 모바일 점수가 모두 일치합니다."
          }
        }
      }
    },
    "All saved plays": {
      "localizations": {
