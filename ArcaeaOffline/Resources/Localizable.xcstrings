        }
      }
    },
    "This changes %lld mobile scores in the selected Google workbook, including the lower scores and clears shown above. ArcProbe's archive stays unchanged. Keep the app open until verification finishes.": {
      "localizations": {
        "ko": {
          "stringUnit": {
